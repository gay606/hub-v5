UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.Y then
            ShrinkConfig.Underground = not ShrinkConfig.Underground
        elseif input.KeyCode == Enum.KeyCode.B then
            ShrinkConfig.HitboxEnabled = not ShrinkConfig.HitboxEnabled
            if updateHitboxUI then
                updateHitboxUI(ShrinkConfig.HitboxEnabled)
            end
        elseif input.KeyCode == Enum.KeyCode.Q then
            features.aim = not features.aim
            setAim(features.aim)
            if updateAimbotUI then
                updateAimbotUI(features.aim)
            end
        elseif input.KeyCode == Enum.KeyCode.R then
            features.speed = not features.speed
            setSpeed(features.speed)
            if updateSpeedUI then
                updateSpeedUI(features.speed)
            end
        elseif input.KeyCode == Enum.KeyCode.C then
            toggleFakeLag()
            updateFakeLagVisual()
        elseif input.KeyCode == Enum.KeyCode.G then
            smartTeleportActive = not smartTeleportActive
            if updateSmartTeleportUI then
                updateSmartTeleportUI(smartTeleportActive)
            end
            if smartTeleportActive then
                runSmartTeleportLoop()
            elseif connections.smartTeleport then
                connections.smartTeleport:Disconnect()
                connections.smartTeleport = nil
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myHrp = char.HumanoidRootPart
        
        if ShrinkConfig.Underground then
            if not lockedY then
                originalY = myHrp.Position.Y
                lockedY = originalY - 12
            end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = false
                end
            end
            myHrp.CFrame = CFrame.new(myHrp.Position.X, lockedY, myHrp.Position.Z)
            myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        else
            if lockedY then
                myHrp.CFrame = CFrame.new(myHrp.Position.X, (originalY or myHrp.Position.Y) + 4, myHrp.Position.Z)
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                if humanoid then
                    humanoid.PlatformStand = false
                end
                lockedY = nil
                originalY = nil
            end
        end
    end

    if fakeLagActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and not hrp.Anchored then
                    hrp.Anchored = true
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Anchored then
                    hrp.Anchored = false
                end
            end
        end
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local pChar = p.Character
            if pChar then
                local hrp = pChar:FindFirstChild("HumanoidRootPart")
                local head = pChar:FindFirstChild("Head")
                if hrp then
                    if ShrinkConfig.HitboxEnabled and not isTeammate(p) then
                        hrp.Size = Vector3.new(ShrinkConfig.HitboxSize, ShrinkConfig.HitboxSize, ShrinkConfig.HitboxSize)
                        hrp.Transparency = 0.5
                        hrp.CanCollide = false
                        if head then head.Size = Vector3.new(4, 4, 4); head.CanCollide = false end
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.CanCollide = true
                        if head then head.Size = Vector3.new(1, 1, 1); head.CanCollide = true end
                    end
                end
            end
        end
    end
end)

