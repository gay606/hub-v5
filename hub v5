-- Smart Teleport cập nhật theo RenderStepped giúp bám dính mượt mà, chống giật tuyệt đối
local function runSmartTeleportLoop()
    if connections.smartTeleport then return end
    
    connections.smartTeleport = RunService.RenderStepped:Connect(function()
        if not smartTeleportActive then
            if connections.smartTeleport then
                connections.smartTeleport:Disconnect()
                connections.smartTeleport = nil
            end
            return
        end

        if not hasOtherPlayersAlive() then
            smartTeleportActive = false
            if updateSmartTeleportUI then
                updateSmartTeleportUI(false)
            end
            if connections.smartTeleport then
                connections.smartTeleport:Disconnect()
                connections.smartTeleport = nil
            end
            return
        end

        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local myHrp = char.HumanoidRootPart
                local targetHrp = nil
                local shortestDist = math.huge
                
                for _, pTarget in pairs(Players:GetPlayers()) do
                    if pTarget ~= player and not isTeammate(pTarget) and pTarget.Character then
                        local pChar = pTarget.Character
                        local pHrp = pChar:FindFirstChild("HumanoidRootPart")
                        local pHum = pChar:FindFirstChild("Humanoid")
                        if pHrp and pHum and pHum.Health > 0 then
                            local dist = (pHrp.Position - myHrp.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetHrp = pHrp
                            end
                        end
                    end
                end
                
                if targetHrp then
                    myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 2.5)
                    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end)
end

