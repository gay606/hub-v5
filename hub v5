-- ESP & Logic
local function createESP(otherPlayer)
    if espObjects[otherPlayer] then return end
    
    local line = Instance.new("Frame", ScreenGui)
    line.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Visible = false
    line.ZIndex = 4

    local nameTag = Instance.new("TextLabel", ScreenGui)
    nameTag.Size = UDim2.new(0, 200, 0, 25)
    nameTag.AnchorPoint = Vector2.new(0.5, 1)
    nameTag.BackgroundTransparency = 1
    nameTag.Text = otherPlayer.Name
    nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameTag.TextSize = 13
    nameTag.Font = Enum.Font.GothamBold
    nameTag.Visible = false
    nameTag.ZIndex = 6

    local uiStroke = Instance.new("UIStroke", nameTag)
    uiStroke.Color = Color3.fromRGB(0, 0, 0)
    uiStroke.Thickness = 1.5

    espObjects[otherPlayer] = {Line = line, NameTag = nameTag}
end

local function removeESP(otherPlayer)
    if espObjects[otherPlayer] then
        if espObjects[otherPlayer].Line then espObjects[otherPlayer].Line:Destroy() end
        if espObjects[otherPlayer].NameTag then espObjects[otherPlayer].NameTag:Destroy() end
        espObjects[otherPlayer] = nil
    end
end

local function isTeammate(otherPlayer)
    return (otherPlayer.Team and player.Team and otherPlayer.Team == player.Team)
end

local function OnCharacterAdded(characterObj, otherPlayer)
    if otherPlayer == player then return end
    if characterObj:FindFirstChild("MyEspHighlight") then
        characterObj.MyEspHighlight:Destroy()
    end
    local highlight = Instance.new("Highlight")
    highlight.Name = "MyEspHighlight"
    highlight.Adornee = characterObj
    highlight.FillColor = EspColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = EspColor
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = features.esp
    highlight.Parent = characterObj
end

Players.PlayerAdded:Connect(function(p)
    if p ~= player then
        createESP(p)
        if p.Character then OnCharacterAdded(p.Character, p) end
        p.CharacterAdded:Connect(function(char) OnCharacterAdded(char, p) end)
    end
end)
Players.PlayerRemoving:Connect(removeESP)

for _, p in pairs(Players:GetPlayers()) do
    if p ~= player then
        createESP(p)
        if p.Character then OnCharacterAdded(p.Character, p) end
        p.CharacterAdded:Connect(function(char) OnCharacterAdded(char, p) end)
    end
end

connections.espLoop = RunService.Heartbeat:Connect(function()
    pcall(function()
        local viewportSize = camera.ViewportSize
        local anyVisible = false
        local startX = viewportSize.X / 2
        local startY = viewportSize.Y - 4
        
        for other, data in pairs(espObjects) do
            local line = data.Line
            local nameTag = data.NameTag
            line.Visible = false
            nameTag.Visible = false
            
            local otherChar = other.Character
            if otherChar then
                local root = otherChar:FindFirstChild("HumanoidRootPart")
                local head = otherChar:FindFirstChild("Head")
                local hum = otherChar:FindFirstChild("Humanoid")
                if root and head and hum and hum.Health > 0 then
                    local rootPos, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        if features.esp then
                            anyVisible = true
                            line.Visible = true
                            local targetX, targetY = rootPos.X, rootPos.Y
                            local distance = math.sqrt((targetX - startX)^2 + (targetY - startY)^2)
                            line.Size = UDim2.new(0, 1.5, 0, distance)
                            line.Position = UDim2.new(0, (startX + targetX) / 2, 0, (startY + targetY) / 2)
                            line.Rotation = math.deg(math.atan2(targetY - startY, targetX - startX)) - 90
                        end

                        if features.espName then
                            local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0))
                            nameTag.Visible = true
                            nameTag.Position = UDim2.new(0, headPos.X, 0, headPos.Y)
                        end
                    end
                end
            end
        end
        bottomDot.Visible = features.esp and anyVisible
    end)
end)

local function setESP(state)
    features.esp = state
    bottomDot.Visible = state
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("MyEspHighlight") then
            p.Character.MyEspHighlight.Enabled = state
        end
    end
end

local function setESPName(state)
    features.espName = state
end

local function getPlayersInCircle()
    if not rootPart or not rootPart.Parent then return {} end
    local myPos = rootPart.Position
    local targets = {}
    
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and not isTeammate(other) then
            local otherChar = other.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                local hum = otherChar:FindFirstChild("Humanoid")
                if otherRoot and hum and hum.Health > 0 then
                    local dist = (otherRoot.Position - myPos).Magnitude
                    if dist <= circleRadius * 2 then
                        table.insert(targets, {Player = other, Root = otherRoot, Distance = dist})
                    end
                end
            end
        end
    end
    table.sort(targets, function(a,b) return a.Distance < b.Distance end)
    return targets
end

local function setAim(state)
    features.aim = state
    fovCircle.Visible = state
    
    if state and not connections.aim then
        connections.aim = RunService.Heartbeat:Connect(function()
            if not features.aim then return end
            pcall(function()
                local targets = getPlayersInCircle()
                if #targets > 0 then
                    local target = targets[1]
                    local otherChar = target.Player.Character
                    if otherChar then
                        local head = otherChar:FindFirstChild("Head") or target.Root
                        if head then
                            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
                        end
                    end
                end
            end)
        end)
    elseif not state and connections.aim then
        connections.aim:Disconnect()
        connections.aim = nil
    end
end

local function setFling(state)
    features.fling = state
    if state and not connections.fling then
        connections.fling = RunService.Heartbeat:Connect(function()
            if not features.fling then return end
            pcall(function()
                if not rootPart or not rootPart.Parent then return end
                local myPos = rootPart.Position
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= player and not isTeammate(other) then
                        local otherChar = other.Character
                        if otherChar then
                            local root = otherChar:FindFirstChild("HumanoidRootPart")
                            if root and (root.Position - myPos).Magnitude < 50 then
                                local dir = (root.Position - myPos).Unit
                                root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + (dir * Vector3.new(math.random(400,800), math.random(300,600), math.random(400,800)))
                            end
                        end
                    end
                end
            end)
        end)
    elseif not state and connections.fling then
        connections.fling:Disconnect()
        connections.fling = nil
    end
end

local function setSpeed(state)
    features.speed = state
    if state and not connections.speed then
        connections.speed = RunService.Heartbeat:Connect(function()
            if not features.speed then return end
            pcall(function()
                if humanoid and humanoid.Parent then
                    humanoid.WalkSpeed = speedValue
                    humanoid.JumpPower = speedValue
                end
            end)
        end)
    elseif not state and connections.speed then
        connections.speed:Disconnect()
        connections.speed = nil
        pcall(function()
            if humanoid and humanoid.Parent then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
            end
        end)
    end
end

local currentAngle = 0
local function setSpin360(state)
    features.spin360 = state
    if state and not connections.spin360 then
        connections.spin360 = RunService.RenderStepped:Connect(function()
            if not features.spin360 then return end
            pcall(function()
                if rootPart and rootPart.Parent then
                    currentAngle = (currentAngle + spinSpeedValue) % 360
                    rootPart.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, math.rad(currentAngle), 0)
                end
            end)
        end)
    elseif not state and connections.spin360 then
        connections.spin360:Disconnect()
        connections.spin360 = nil
    end
end

